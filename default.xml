  <!-- Halted at mesh-latents/v0.1.0-dev.1.

       Every project is pinned to the halt tag rather than to a branch, so a
       `repo sync` reproduces the tree as it stood when work stopped instead of
       moving it forward. The manifest itself is the exception: it stays on main,
       because the thing recording the halt cannot also be halted by it.

       Stage names follow RFD 0067: dev, beta, rc, then release, ordered by
       creator date. The mesh-latents/ prefix keeps the halt off each project's own
       release line, which it makes no claim about.

       To resume, put the revisions back to main. The pin is the halt.
  -->

  <remote name="weftspun" fetch="https://github.com/weftspun" />
  <remote name="sinew-mocap" fetch="https://github.com/sinew-mocap" />
  <remote name="v-sekai-fabric" fetch="https://github.com/v-sekai-fabric" />

  <default sync-j="16" />

